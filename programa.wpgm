import escenario.*
import wollok.game.*
import ingeniero.*
import movimiento.*
import enemigos.*
import proyectiles.* 


program juego {
  game.width(160)
  game.height(90)
  game.cellSize(50)
  game.title("Juego")


  game.addVisual(ingeniero)
  movimiento.configurarFlechas(ingeniero)
  game.addVisual(banco1)
  game.addVisual(banco2)
  game.addVisual(mesa1)
  game.addVisual(mesa2)
  game.addVisual(utnianos)
  game.addVisual(haskell)

  game.boardGround('tablero.jpeg')

  game.onCollideDo(ingeniero, { 
   elemento => elemento.serAgarradoPor(ingeniero)

  })

  game.onTick(700, "movimientoHaskell", {haskell.perseguir(ingeniero)})

// no creo que esto esté bien pero no se me ocurrio otra forma
  game.onTick(100, "atacarEnSuPosicion", {haskell.atacarEnSuPosicion()})

  game.start()

}




