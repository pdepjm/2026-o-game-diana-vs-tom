import escenario.*
import wollok.game.*
import ingeniero.*
import movimiento.*

program juego {
  game.width(100)
  game.height(100)
  game.cellSize(50)
  game.title("Juego")

  game.addVisual(ingeniero)
  movimiento.configurarFlechas(ingeniero)
  game.addVisual(banco1)
  game.addVisual(utnianos)

  game.boardGround('tablero.jpeg')


  game.start()

}



